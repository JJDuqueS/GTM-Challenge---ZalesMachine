# Copiá este archivo a .env (cp .env.example .env) y pegá tus valores reales ahí.
# .env NUNCA se commitea - ya está en .gitignore. Este archivo (.env.example) sí
# se commitea, para que cualquiera sepa qué variables necesita sin ver el valor real.

# URL del webhook de la tabla de Clay (Fase 2 del challenge: tabla con source
# "Pull in data from a Webhook"). Sin esto, send_to_clay.py corre siempre en
# --dry-run - nunca manda nada por accidente.
CLAY_WEBHOOK_URL=
